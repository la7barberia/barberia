# URL pública del perfil de La 7 Barbería en Booksy.
# Déjala vacía hasta tener la URL definitiva del establecimiento: mientras esté vacía,
# la web no muestra ningún botón de Booksy y WhatsApp pasa a ser el CTA principal.
# Nunca uses la página genérica de categoría de barberías de Booksy.
NEXT_PUBLIC_BOOKSY_URL=

# Dominio definitivo (canonical, sitemap, Open Graph). Sin barra final.
# Pendiente de definir: si está vacío se usa http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
